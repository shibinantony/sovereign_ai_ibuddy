# Local generation is the default. npm run setup resolves the three path placeholders
# to absolute paths under %LOCALAPPDATA%\iBuddy so they stay outside the repository.
# Repair runs preserve every existing policy, tuning, provider, and credential value.
IBUDDY_MODEL_BACKEND=llama_cpp
IBUDDY_OFFLINE=true
LLAMA_CPP_SERVER_PATH=%LOCALAPPDATA%\iBuddy\runtime\llama.cpp\llama-server.exe
LLAMA_CPP_MODEL_PATH=%LOCALAPPDATA%\iBuddy\models\Qwen3-8B-Q5_K_M.gguf
LLAMA_CPP_HOST=127.0.0.1
LLAMA_CPP_PORT=18080
LLAMA_CPP_CONTEXT_SIZE=8192
LLAMA_CPP_THREADS=8
LLAMA_CPP_GPU_LAYERS=0
LLAMA_CPP_STARTUP_TIMEOUT_SECONDS=180
LLAMA_CPP_ENABLE_THINKING=false

# Optional hosted Hugging Face generation. These are unused in llama_cpp mode.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct-1M
HF_PROVIDER=auto
# HF_BASE_URL=https://your-inference-endpoint.example.com/v1
MAX_NEW_TOKENS=1200
MODEL_TEMPERATURE=0.25
MODEL_TIMEOUT_SECONDS=120

# Smart web retrieval is opt-in. Strict external-egress blocking is IBUDDY_OFFLINE=true.
# Auto prefers Tavily, then Brave, then keyless DuckDuckGo when online.
SEARCH_PROVIDER=auto
SEARCH_SAFESEARCH=moderate
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARCH_RESULT_COUNT=4
SEARCH_TIMEOUT_SECONDS=6

# Runtime and persistence
IBUDDY_ENV=development
IBUDDY_DATABASE_PATH=%LOCALAPPDATA%\iBuddy\data\ibuddy.db
IBUDDY_FRONTEND_DIST=frontend/dist
HISTORY_MESSAGE_LIMIT=24
MAX_USER_CHARS=12000
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
IBUDDY_DEBUG=false
